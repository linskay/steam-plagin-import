<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Epic Sync // Cyberpunk 2077" Height="770" Width="890"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <!-- Custom Cyberpunk 2077 ScrollBar Thumb -->
        <Style x:Key="CyberScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder" Background="#FCEE0A" CornerRadius="1" Margin="1,0,1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#00F0FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#FFF23D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Cyberpunk 2077 ScrollBar Style (Global for ListBox & ScrollViewers) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="#0A0B10">
                            <Border BorderBrush="#1C2130" BorderThickness="1,0,0,0" HorizontalAlignment="Left" Width="1"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CyberScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="5"/>
                                <Setter Property="MinHeight" Value="5"/>
                                <Setter Property="Width" Value="Auto"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyberpunk Yellow Action Button Style with thin clean border -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#FCEE0A"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E6D905"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE600"/>
                    <Setter Property="BorderBrush" Value="#FFF23D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D4C700"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cyberpunk Secondary Cyan Button Style with thin 1px line -->
        <Style x:Key="CyberSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#10131D"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00F0FF"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#00B8C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cyberpunk Install Shortcut Button Style with thin yellow 1px line -->
        <Style x:Key="CyberInstallButton" TargetType="Button">
            <Setter Property="Background" Value="#131622"/>
            <Setter Property="Foreground" Value="#FCEE0A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FCEE0A"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FCEE0A"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D4C700"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cyberpunk Danger Red Button Style with thin red 1px line -->
        <Style x:Key="CyberDangerButton" TargetType="Button">
            <Setter Property="Background" Value="#150E14"/>
            <Setter Property="Foreground" Value="#FF003C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF003C"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF003C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C7002E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Cyberpunk CheckBox with sleek 1px hairline border -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#D6DFEC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="checkBorder" Grid.Column="0" Width="14" Height="14" Background="#0C0E14" BorderBrush="#252D40" BorderThickness="1" CornerRadius="1" VerticalAlignment="Center">
                                <Path x:Name="checkMark" Data="M 2 6 L 5 9 L 10 3" Stroke="#FCEE0A" StrokeThickness="1.5" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#00F0FF"/>
                                <Setter TargetName="checkBorder" Property="Background" Value="#121824"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#FCEE0A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Outer Window Border: Thin, refined 1px Cyberpunk Yellow Hairline -->
    <Border CornerRadius="4" Background="#090A0E" BorderBrush="#FCEE0A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <!-- 0. Header Title Bar -->
                <RowDefinition Height="88"/>
                <!-- 1. Hero Banner -->
                <RowDefinition Height="*"/>
                <!-- 2. Main Content Split -->
                <RowDefinition Height="30"/>
                <!-- 3. Status Bar -->
            </Grid.RowDefinitions>

            <!-- 0. Title Bar with thin 1px bottom border -->
            <Grid Grid.Row="0" Name="TitleBar" Background="#06070B">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#181D2A" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Grid.ColumnSpan="2"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Background="#FCEE0A" CornerRadius="1" Padding="4,1,4,1" Margin="0,0,8,0">
                        <TextBlock Text="CP // 2077" Foreground="#000000" FontSize="9" FontWeight="Bold"/>
                    </Border>
                    <Ellipse Width="5" Height="5" Fill="#00F0FF" Margin="0,0,8,0"/>
                    <TextBlock Text="// STEAM ✕ EPIC SYNC // NETRUNNER PROTOCOL //" Foreground="#95A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Name="MinBtn" Width="26" Height="24" Content="—" Foreground="#00F0FF" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="11">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#131B2A"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Name="CloseBtn" Width="26" Height="24" Content="✕" Foreground="#FF003C" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="10" Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF003C"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1. Hero Banner (Thin Hairline Accents) -->
            <Grid Grid.Row="1">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#08090D" Offset="0.0"/>
                        <GradientStop Color="#10141F" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Thin 1px Top Neon Accent Line -->
                <Border Height="1" Background="#FCEE0A" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                <!-- Thin 1px Bottom Divider Line -->
                <Border Height="1" Background="#161B28" VerticalAlignment="Bottom" Grid.ColumnSpan="2"/>

                <StackPanel VerticalAlignment="Center" Margin="22,0,0,0">
                    <TextBlock Text="// NIGHT CITY PROTOCOL // DIRECT MEMORY LINK" Foreground="#00F0FF" FontSize="9" FontWeight="Bold"/>
                    <TextBlock Text="STEAM ✕ EPIC GAMES" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    <TextBlock Text="Автономный импорт библиотеки Epic в Steam · Оптимизация ОЗУ · Оформление" Foreground="#6E7B91" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Name="SyncBtn" Style="{StaticResource CyberButton}" Content="⚡ СИНХРОНИЗИРОВАТЬ СЕЙЧАС" VerticalAlignment="Center" Margin="0,0,22,0"/>
            </Grid>

            <!-- 2. Content Area (Split: Left Settings, Right Games List) -->
            <Grid Grid.Row="2" Margin="18,12,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="285"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column with Custom Cyberpunk ScrollViewer -->
                <ScrollViewer Grid.Column="0" Margin="0,0,14,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Shortcut Box (Значок установки ярлыка) with thin 1px border -->
                        <TextBlock Text="// ЯРЛЫК НА РАБОЧЕМ СТОЛЕ //" Foreground="#FCEE0A" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Border Background="#0F111A" CornerRadius="2" Padding="12" BorderBrush="#50FCEE0A" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Вывести стильный ярлык на рабочий стол для быстрого запуска утилиты." Foreground="#9AA8BC" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Name="CreateShortcutBtn" Style="{StaticResource CyberInstallButton}" Content="⚡ УСТАНОВИТЬ ЯРЛЫК (2077)" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                                <TextBlock Name="ShortcutStatusTxt" Text="[СТАТУС ЯРЛЫКА: ПРОВЕРКА...]" Foreground="#00F0FF" FontSize="9" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- System Settings with thin 1px borders -->
                        <TextBlock Text="// НАСТРОЙКИ СИСТЕМЫ //" Foreground="#00F0FF" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Border Background="#0F111A" CornerRadius="2" Padding="12" BorderBrush="#1C2132" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Name="SteamStartupChk" Content="Запуск вместе со Steam" Margin="0,0,0,8"/>
                                <CheckBox Name="StartupSyncChk" Content="Синхронизация при запуске Steam" Margin="0,0,0,8"/>
                                <TextBlock Text="При автосинхронизации Steam один раз перезапускается для безопасной записи базы." Foreground="#6E7B91" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Название коллекции в Steam" Foreground="#9AA8BC" FontSize="10" Margin="0,0,0,4"/>
                                <TextBox Name="CollectionNameBox" MaxLength="80" Padding="5" Background="#08090E" Foreground="#FFFFFF" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,0,0,8" FontSize="11"/>
                                <Button Name="SaveSettingsBtn" Style="{StaticResource CyberSecondaryButton}" Content="Сохранить настройки" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                <TextBlock Name="SettingsMessage" Foreground="#FCEE0A" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <CheckBox Name="StartupChk" Content="Автозапуск с Windows" Margin="0,0,0,8"/>
                                <CheckBox Name="CloseEgsChk" Content="Закрывать EGS после выхода из игры" IsChecked="True" Margin="0,0,0,8"/>
                                <TextBlock Text="Импортируются также неустановленные игры из облака EGS." Foreground="#6E7B91" FontSize="9" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Epic Games Account with thin 1px border -->
                        <TextBlock Text="// СТАТУС EPIC GAMES ID //" Foreground="#00F0FF" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Border Background="#0F111A" CornerRadius="2" Padding="12" BorderBrush="#1C2132" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Name="EpicStatusTxt" Text="Статус: Не авторизован" Foreground="#9AA8BC" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <Button Name="EpicLoginBtn" Style="{StaticResource CyberSecondaryButton}" Content="Подключить аккаунт" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <!-- Emergency Reset with thin 1px red border -->
                        <TextBlock Text="// АВАРИЙНЫЙ СБРОС //" Foreground="#FF003C" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Border Background="#0F111A" CornerRadius="2" Padding="12" BorderBrush="#2D151D" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Удалить все импортированные ярлыки из Steam, очистить кэш и настройки." Foreground="#6E7B91" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Name="UninstallBtn" Style="{StaticResource CyberDangerButton}" Content="ПОЛНОЕ УДАЛЕНИЕ УТИЛИТЫ" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Column: Games Database with thin 1px border and custom ScrollViewer -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="// БАЗА ДАННЫХ ИГР [NEURAL ARCHIVE] //" Foreground="#00F0FF" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>

                    <ListBox Grid.Row="1" Name="GamesListBox" Background="#090B10" BorderBrush="#1C2132" BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="4">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- 3. Bottom Status Bar with thin 1px hairline border -->
            <Grid Grid.Row="3" Background="#06070B" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Top Status Border Line -->
                <Border Height="1" Background="#181D2A" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

                <TextBlock Grid.Column="0" Name="StatusTxt" Text="[ STATUS: ГОТОВ К РАБОТЕ // CYBER LINK ACTIVE ]" Foreground="#FCEE0A" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBlock Grid.Column="1" Text="CYBERPUNK 2077 EDITION // V2.077" Foreground="#00F0FF" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
