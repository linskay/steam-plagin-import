<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Epic Sync // Cyberpunk 2077" Height="770" Width="890"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <!-- Cyberpunk Yellow Action Button Style -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#FCEE0A"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE600"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D4C700"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cyberpunk Secondary Cyan Button Style -->
        <Style x:Key="CyberSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#141722"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00F0FF"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#00B8C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cyberpunk Install Shortcut Button Style -->
        <Style x:Key="CyberInstallButton" TargetType="Button">
            <Setter Property="Background" Value="#181B28"/>
            <Setter Property="Foreground" Value="#FCEE0A"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#FCEE0A"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FCEE0A"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D4C700"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cyberpunk Danger Red Button Style -->
        <Style x:Key="CyberDangerButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1117"/>
            <Setter Property="Foreground" Value="#FF003C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF003C"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF003C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C7002E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Cyberpunk CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E6F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Main Cyberpunk Outer Border -->
    <Border CornerRadius="8" Background="#0B0C10" BorderBrush="#FCEE0A" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <!-- 0. Header Title Bar -->
                <RowDefinition Height="96"/>
                <!-- 1. Hero Banner -->
                <RowDefinition Height="*"/>
                <!-- 2. Main Content Split -->
                <RowDefinition Height="34"/>
                <!-- 3. Status Bar -->
            </Grid.RowDefinitions>

            <!-- 0. Title Bar -->
            <Grid Grid.Row="0" Name="TitleBar" Background="#07080B">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Border Background="#FCEE0A" CornerRadius="2" Padding="5,2,5,2" Margin="0,0,10,0">
                        <TextBlock Text="CP // 2077" Foreground="#000000" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Ellipse Width="7" Height="7" Fill="#00F0FF" Margin="0,0,8,0"/>
                    <TextBlock Text="// STEAM ✕ EPIC SYNC // NETRUNNER PROTOCOL //" Foreground="#A6B4C9" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Name="MinBtn" Width="30" Height="28" Content="—" Foreground="#00F0FF" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A2234"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Name="CloseBtn" Width="30" Height="28" Content="✕" Foreground="#FF003C" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="5,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF003C"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1. Hero Banner (Cyberpunk Gradient & Accent Bar) -->
            <Grid Grid.Row="1" Margin="0,0,0,1">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#090A0F" Offset="0.0"/>
                        <GradientStop Color="#141824" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Top Yellow Accent Line -->
                <Border Height="2" Background="#FCEE0A" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

                <StackPanel VerticalAlignment="Center" Margin="25,0,0,0">
                    <TextBlock Text="// NIGHT CITY PROTOCOL // DIRECT MEMORY LINK" Foreground="#00F0FF" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="STEAM ✕ EPIC GAMES" Foreground="#FFFFFF" FontSize="23" FontWeight="Bold" Margin="0,2,0,0"/>
                    <TextBlock Text="Автономный импорт библиотеки Epic в Steam · Оптимизация ОЗУ · Оформление" Foreground="#7A8499" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Name="SyncBtn" Style="{StaticResource CyberButton}" Content="⚡ СИНХРОНИЗИРОВАТЬ СЕЙЧАС" VerticalAlignment="Center" Margin="0,0,25,0"/>
            </Grid>

            <!-- 2. Content Area (Left: Settings & Shortcut, Right: Games Database) -->
            <Grid Grid.Row="2" Margin="20,15,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <ScrollViewer Grid.Column="0" Margin="0,0,15,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Shortcut Box (Значок установки ярлыка) -->
                        <TextBlock Text="// ЯРЛЫК НА РАБОЧЕМ СТОЛЕ //" Foreground="#FCEE0A" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Border Background="#12141D" CornerRadius="6" Padding="14" BorderBrush="#FCEE0A" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Вывести стильный ярлык на рабочий стол для быстрого запуска утилиты." Foreground="#A6B4C9" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button Name="CreateShortcutBtn" Style="{StaticResource CyberInstallButton}" Content="⚡ УСТАНОВИТЬ ЯРЛЫК (2077)" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                <TextBlock Name="ShortcutStatusTxt" Text="[СТАТУС ЯРЛЫКА: ПРОВЕРКА...]" Foreground="#00F0FF" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- System Settings -->
                        <TextBlock Text="// НАСТРОЙКИ СИСТЕМЫ //" Foreground="#00F0FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Border Background="#12141D" CornerRadius="6" Padding="14" BorderBrush="#232738" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <CheckBox Name="SteamStartupChk" Content="Запуск вместе со Steam" Margin="0,0,0,10"/>
                                <CheckBox Name="StartupSyncChk" Content="Синхронизация при запуске Steam" Margin="0,0,0,10"/>
                                <TextBlock Text="При автосинхронизации Steam один раз перезапускается для безопасной записи базы." Foreground="#7A8499" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                
                                <TextBlock Text="Название коллекции в Steam" Foreground="#A6B4C9" FontSize="11" Margin="0,0,0,5"/>
                                <TextBox Name="CollectionNameBox" MaxLength="80" Padding="7" Background="#0A0B10" Foreground="#FFFFFF" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,0,0,10"/>
                                <Button Name="SaveSettingsBtn" Style="{StaticResource CyberSecondaryButton}" Content="Сохранить настройки" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                                <TextBlock Name="SettingsMessage" Foreground="#FCEE0A" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <CheckBox Name="StartupChk" Content="Автозапуск с Windows" Margin="0,0,0,10"/>
                                <CheckBox Name="CloseEgsChk" Content="Закрывать EGS после выхода из игры" IsChecked="True" Margin="0,0,0,10"/>
                                <TextBlock Text="Импортируются также неустановленные игры из облака EGS." Foreground="#7A8499" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Epic Games Account -->
                        <TextBlock Text="// СТАТУС EPIC GAMES ID //" Foreground="#00F0FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Border Background="#12141D" CornerRadius="6" Padding="14" BorderBrush="#232738" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Name="EpicStatusTxt" Text="Статус: Не авторизован" Foreground="#A6B4C9" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Button Name="EpicLoginBtn" Style="{StaticResource CyberSecondaryButton}" Content="Подключить аккаунт" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <!-- Emergency Reset -->
                        <TextBlock Text="// АВАРИЙНЫЙ СБРОС //" Foreground="#FF003C" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Border Background="#12141D" CornerRadius="6" Padding="14" BorderBrush="#3D1822" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Удалить все импортированные ярлыки из Steam, очистить кэш и настройки." Foreground="#7A8499" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button Name="UninstallBtn" Style="{StaticResource CyberDangerButton}" Content="ПОЛНОЕ УДАЛЕНИЕ УТИЛИТЫ" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Column: Database of Games -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="// БАЗА ДАННЫХ ИГР [NEURAL ARCHIVE] //" Foreground="#00F0FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1" Name="GamesListBox" Background="#0C0D14" BorderBrush="#232738" BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="6">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- 3. Bottom Status Bar -->
            <Grid Grid.Row="3" Background="#07080B" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Top Status Border Line -->
                <Border Height="1" Background="#232738" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

                <TextBlock Grid.Column="0" Name="StatusTxt" Text="[ STATUS: ГОТОВ К РАБОТЕ // CYBER LINK ACTIVE ]" Foreground="#FCEE0A" FontSize="11" VerticalAlignment="Center" Margin="15,0,0,0"/>
                <TextBlock Grid.Column="1" Text="CYBERPUNK 2077 EDITION // V2.077" Foreground="#00F0FF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
