<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Epic Sync" Height="500" Width="750" 
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <!-- Modern Rounded Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                BorderThickness="0" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2C38"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F4257"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35384A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1F212C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Checkbox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Main Window Border with Drop Shadow Accent -->
    <Border CornerRadius="12" Background="#12131A" BorderBrush="#222430" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <!-- Header Title Bar -->
                <RowDefinition Height="90"/>
                <!-- Hero Section -->
                <RowDefinition Height="*"/>
                <!-- Content Section -->
                <RowDefinition Height="35"/>
                <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Grid Grid.Row="0" Name="TitleBar" Background="#181A22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <!-- Stylized dot -->
                    <Ellipse Width="8" Height="8" Fill="#00C853" Margin="0,0,8,0"/>
                    <TextBlock Text="Steam Epic Sync" Foreground="#A0A5B5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Name="MinBtn" Width="30" Height="30" Content="—" Foreground="#888888" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#252836"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Name="CloseBtn" Width="30" Height="30" Content="✕" Foreground="#888888" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="5,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Hero Section (Gradient Banner) -->
            <Grid Grid.Row="1" Background="#161822" Margin="0,0,0,1">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#161822" Offset="0.0"/>
                        <GradientStop Color="#0D1E36" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="25,0,0,0">
                    <TextBlock Text="ИНТЕГРАЦИЯ БИБЛИОТЕК" Foreground="#00C853" FontSize="11" FontWeight="Bold" LetterSpacing="1.5"/>
                    <TextBlock Text="Epic Games ✕ Steam" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,2,0,0"/>
                    <TextBlock Text="Импортируйте игры Epic в Steam и экономьте ресурсы ПК" Foreground="#8A92A6" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Name="SyncBtn" Style="{StaticResource ModernButton}" Content="Синхронизировать сейчас" VerticalAlignment="Center" Margin="0,0,25,0" Padding="20,12"/>
            </Grid>

            <!-- 3. Content Area (Split: Left = Settings, Right = Games List) -->
            <Grid Grid.Row="2" Margin="20,15,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Left: Settings -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="НАСТРОЙКИ" Foreground="#8A92A6" FontSize="11" FontWeight="Bold" Margin="0,0,0,12" LetterSpacing="1"/>
                    
                    <Border Background="#161822" CornerRadius="8" Padding="15" BorderBrush="#222430" BorderThickness="1">
                        <StackPanel>
                            <CheckBox Name="StartupChk" Content="Автозапуск с Windows" Margin="0,0,0,15"/>
                            <CheckBox Name="CloseEgsChk" Content="Закрывать EGS после игры" IsChecked="True" Margin="0,0,0,15"/>
                            <TextBlock Text="Утилита будет автоматически синхронизировать библиотеку при запуске и завершать фоновые процессы Epic Games после выхода из игры." 
                                       Foreground="#6C7281" FontSize="11" TextWrapping="Wrap" LineHeight="15"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="АККАУНТ EPIC GAMES" Foreground="#8A92A6" FontSize="11" FontWeight="Bold" Margin="0,15,0,10" LetterSpacing="1"/>
                    <Border Background="#161822" CornerRadius="8" Padding="15" BorderBrush="#222430" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Name="EpicStatusTxt" Text="Статус: Не авторизован" Foreground="#A0A5B5" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <Button Name="EpicLoginBtn" Style="{StaticResource SecondaryButton}" Content="Подключить аккаунт" Padding="10,6" FontSize="11" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ПОДДЕРЖКА И УДАЛЕНИЕ" Foreground="#8A92A6" FontSize="11" FontWeight="Bold" Margin="0,15,0,10" LetterSpacing="1"/>
                    <Border Background="#161822" CornerRadius="8" Padding="15" BorderBrush="#222430" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Чтобы изменения отобразились в Steam, перезапустите клиент Steam после синхронизации." 
                                       Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,10"/>
                            <Button Name="UninstallBtn" Style="{StaticResource SecondaryButton}" Content="Полное удаление утилиты" Padding="10,6" FontSize="11" HorizontalAlignment="Stretch" Foreground="#FF6B6B" BorderBrush="#3D2424"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Games List -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ОБНАРУЖЕННЫЕ ИГРЫ EPIC GAMES" Foreground="#8A92A6" FontSize="11" FontWeight="Bold" Margin="0,0,0,12" LetterSpacing="1"/>

                    <!-- Scrollable Games ListBox -->
                    <ListBox Grid.Row="1" Name="GamesListBox" Background="#161822" BorderBrush="#222430" BorderThickness="1" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="5" CornerRadius="8">
                        <ListBox.Resources>
                            <!-- Remove default ListBoxItem styling -->
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- 4. Status Bar -->
            <Grid Grid.Row="3" Background="#101117" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Name="StatusTxt" Text="Готов к синхронизации" Foreground="#6C7281" FontSize="11" VerticalAlignment="Center" Margin="15,0,0,0"/>
                <TextBlock Grid.Column="1" Text="v1.0.0 | Легковесный режим" Foreground="#4A4F5C" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
